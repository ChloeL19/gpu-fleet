# Copy to config.env and fill in. config.env is gitignored, so keys stay local.
# This file is read both by bash (`source`) and by management/mydotenv.py:
# keep the KEY="value" form and the MACHINE_NAME_LIST=( ... ) block as-is.

# --- Provider keys ---
RUNPOD_API_KEY=""
VASTAI_API_KEY=""                      # optional; leave blank to use RunPod only

# --- Shared SSH key (every pod trusts it; participants get the private half) ---
# Make one per program:  ssh-keygen -t ed25519 -N "" -f ~/.ssh/<program>_shared
SHARED_SSH_KEY_PATH="~/.ssh/program_shared"
SSH_USER="root"

# --- Pod naming ---
# Pods are named "<prefix>-<name>". The proxy gives name #i the port
# SSH_PROXY_STARTING_PORT + i, so never reorder or delete names mid-program;
# append new ones at the end.
MACHINE_NAME_PREFIX="gpu"

# --- Pod defaults (RunPod) ---
RUNPOD_GPU_TYPE="NVIDIA RTX A4000"
RUNPOD_CLOUD_TYPE="COMMUNITY"          # COMMUNITY (cheaper) or SECURE
RUNPOD_NUM_GPUS=1
# Default: the ARENA image (RunPod's PyTorch image plus a conda env "arena-env"
# with transformer_lens, transformers, datasets, einops, peft, ... preinstalled),
# so pods are ready to work the moment they boot. For a plain, smaller image use
# runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04 and set
# POD_PYTHON="python3". Any image works if it starts sshd from its CMD using the
# PUBLIC_KEY env var, as RunPod's official images do via /start.sh.
RUNPOD_DOCKER_IMAGE="nickypro/arena-env:6.1"
RUNPOD_DISK_SPACE_IN_GB=100
RUNPOD_VOLUME_SPACE_IN_GB=0

# --- Optional pod boot hook ---
# Shell snippet run at every pod start, before sshd (e.g. `cd /root/repo && git pull`).
# Any shell is fine (it's passed base64-encoded); use single quotes around the
# whole value if it contains $ or ". Blank = the image boots as-is.
POD_SETUP_CMD=""
# Python on the pods, used by check_pods' CUDA check (the image's main environment).
POD_PYTHON="/opt/conda/envs/arena-env/bin/python"

# --- Where deploy_keys writes API keys on each pod ---
POD_ENV_FILE="/root/.env"

# --- OpenRouter per-pod keys (generate_openrouter_keys.py / openrouter_spend_report.py) ---
# Key names are <prefix>-<name>-<KEY_COHORT>; use a new value each program cycle.
KEY_COHORT="fall26"

# --- SSH proxy (the always-on box running nginx) ---
SSH_PROXY_USER="root"
SSH_PROXY_HOST="your.proxy.host"       # domain or public IP of the proxy box
SSH_PROXY_STARTING_PORT=16000

MACHINE_NAME_LIST=(
    "alder"
    "birch"
    "cedar"
    "dogwood"
    "elm"
    "fir"
    "ginkgo"
    "hazel"
    "ironwood"
    "juniper"
    "kapok"
    "larch"
    "maple"
    "nutmeg"
    "oak"
    "pine"
    "quince"
    "redwood"
    "spruce"
    "teak"
    "willow"
    "yew"
    "zelkova"
    "aspen"
    "beech"
    "cypress"
    "ebony"
    "fig"
    "holly"
    "linden"
)

# --- Pairs (pair_fleet): one network-volume pod per pair of participants ---
# Volume pods are SECURE cloud and region-locked: pick a datacenter that has both
# network-volume support and this GPU (see NETWORK_VOLUMES.md, "Picking a datacenter").
PAIR_GPU_TYPE="NVIDIA RTX A4000"
PAIR_DATA_CENTER=""                    # e.g. US-NE-1
PAIR_VOLUME_SIZE_GB=50

# --- Airtable check-in (pair_fleet --from-airtable / --assign); optional ---
# Personal access token with data.records:read (and data.records:write for --assign),
# scoped to the one base. IDs come from the view's URL: airtable.com/<base>/<table>/<view>
AIRTABLE_TOKEN=""
AIRTABLE_BASE_ID=""
AIRTABLE_TABLE_ID=""
AIRTABLE_VIEW_ID=""                    # the meeting's check-in view
AIRTABLE_NAME_FIELD="Name"
AIRTABLE_ATTENDED_FIELD=""             # checkbox, e.g. "Attended Meeting 2?"
AIRTABLE_POD_FIELD=""                  # text field --assign writes, e.g. "Meeting 2 Pod"
